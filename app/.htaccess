Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Bloquea acceso directo a codigo interno.
RewriteRule ^(Controllers|Core|Model|Views)(/|$) - [F,L,NC]
RewriteRule ^bootstrap\.php$ - [F,L,NC]

# Permite archivos existentes en app (index, etc.).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demas pasa por el front controller.
RewriteRule ^ index.php [L,QSA]
</IfModule>
